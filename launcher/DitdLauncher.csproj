<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Launcher Windows : .NET Framework 4.8 (inclus dans Windows 10/11), donc aucun runtime à installer.
    Version = celle publiée dans dist/manifest.json (launcherVersion) ; publish.ps1 la passe via -p:Version.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DitdCoopLauncher</AssemblyName>
    <RootNamespace>DitdLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DitD Coop Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
